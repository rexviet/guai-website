HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Cloudflare R2 (S3-compatible upload provider, see config/plugins.ts)
# R2 access key id, from an R2 API token with object read/write scope
R2_ACCESS_KEY_ID=tobemodified
# R2 secret access key paired with R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=tobemodified
# R2 bucket name that stores Strapi media uploads
R2_BUCKET=tobemodified
# R2 S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=tobemodified
# R2 region; R2 has no real regions, keep "auto" unless Cloudflare docs say otherwise
R2_REGION=auto
# Public CDN domain serving the bucket, e.g. https://media.guai.studio
R2_PUBLIC_URL=tobemodified
