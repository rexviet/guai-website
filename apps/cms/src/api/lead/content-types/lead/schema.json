{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Lead",
    "description": "Contact form submissions and project brief leads."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "service_interest": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "attachment": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "ip_address": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "qualified", "archived"],
      "default": "new"
    }
  }
}
