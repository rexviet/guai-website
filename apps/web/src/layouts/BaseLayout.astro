---
import { generateSeoTags, type SeoMeta } from '../lib/seo';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  seo?: SeoMeta;
  lang?: string;
  showNav?: boolean;
}

const { seo, lang = "vi", showNav = true } = Astro.props;
const seoHtml = generateSeoTags(seo);
---

<!DOCTYPE html>
<html data-wf-domain="kakao-wcopilot.webflow.io" data-wf-page="648aca19f05d659650f20c2b" data-wf-site="648aca18f05d659650f20acc" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={seoHtml} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <link href="https://cdn.prod.website-files.com" rel="preconnect" crossorigin="anonymous" />
    <link href="https://cdn.prod.website-files.com/648aca18f05d659650f20acc/css/kakao-wcopilot.webflow.41a000530.css" rel="stylesheet" type="text/css" />
    
    <style is:global>
      a.w-webflow-badge, .w-webflow-badge { 
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
      }
    </style>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const removeBadge = () => {
          const badge = document.querySelector('.w-webflow-badge');
          if (badge) badge.remove();
        };
        removeBadge();
        const observer = new MutationObserver(removeBadge);
        observer.observe(document.body, { childList: true, subtree: true });
        setTimeout(() => observer.disconnect(), 5000); // stop observing after 5s
      });
    </script>
    <style>@media (min-width:992px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="e6d22654-adaf-4ec0-4e42-4a23aa445be4"] {display:none;-webkit-transform:translate3d(0, 0, 0) scale3d(0.3, 0.3, 1) rotateX(0) rotateY(0) rotateZ(0) skew(-20deg, -20deg);-moz-transform:translate3d(0, 0, 0) scale3d(0.3, 0.3, 1) rotateX(0) rotateY(0) rotateZ(0) skew(-20deg, -20deg);-ms-transform:translate3d(0, 0, 0) scale3d(0.3, 0.3, 1) rotateX(0) rotateY(0) rotateZ(0) skew(-20deg, -20deg);transform:translate3d(0, 0, 0) scale3d(0.3, 0.3, 1) rotateX(0) rotateY(0) rotateZ(0) skew(-20deg, -20deg);opacity:0;}}</style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript" is:inline></script>
    <script type="text/javascript" is:inline>WebFont.load({  google: {    families: ["Lato:100,100italic,300,300italic,400,400italic,700,700italic,900,900italic","Syne:regular,500,600,700,800","Montserrat Alternates:regular,500,600,700,800,900","Sora:300,regular,500,600,700,800","Heebo:300,regular,500,600,700,800,900"]  }});</script>
    <script type="text/javascript" is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/favicon.svg" rel="apple-touch-icon" />
    <!-- CSS overrides: fix z-index stacking for sticky footer pattern -->
    <style is:inline>
      /*
       * === GUAI STUDIO — DESIGN SYSTEM OVERRIDES ===
       * Brief: Midnight Blue #0B1026 + Electric Violet #6C4DFF
       *        + Cyan #22D3EE + gradient/glow CTAs
       *
       * Strategy: Override Kakao's root variables so all Kakao
       * components automatically pick up the new palette.
       */

      /* 1. Bridge Kakao variables → Brief palette */
      :root {
        --primary-black: #0B1026;    /* Midnight Blue (was black) */
        --white: #ffffff;
        --white-50: #ffffff80;
        --white-25: #ffffff40;
        --white-5-51: #ffffff0d;
        --white-1: #ffffff03;
      }

      /* 2. Global background */
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100vw !important;
        background-color: #0B1026 !important;
      }

      /* 3. Section backgrounds inherit Midnight Blue */
      section.section,
      #Our-Benefits,
      #recent-work,
      .section-news {
        position: relative;
        z-index: 50;
        background-color: #0B1026;
      }

      /* 4. Accent color override: Webflow blue → Electric Violet */
      .w-form-formradioinput--inputType-custom.w--redirected-focus {
        box-shadow: 0 0 3px 1px #6C4DFF;
      }
      .w-form-formradioinput--inputType-custom.w--redirected-checked {
        border-color: #6C4DFF;
      }

      /* 5. Primary CTA gradient: Violet → Cyan */
      .primary-gradient-button,
      .btn-primary {
        background-color: transparent !important;
        background-image: linear-gradient(135deg, #6C4DFF 0%, #22D3EE 100%) !important;
        box-shadow: 0 0 20px rgba(108, 77, 255, 0.35) !important;
        border-radius: 8px !important;
        color: #fff !important;
        transition: all 0.35s ease !important;
      }
      .primary-gradient-button:hover,
      .btn-primary:hover {
        opacity: 1 !important;
        background-image: linear-gradient(135deg, #8a6bff 0%, #38e8ff 100%) !important;
        box-shadow: 0 0 35px rgba(108, 77, 255, 0.65), 0 0 60px rgba(34, 211, 238, 0.2) !important;
        transform: translateY(-1px);
      }

      /* 6. Circle CTA buttons — violet glow on hover */
      .btn-circle:hover,
      .circle-footer-lin:hover {
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
      }

      /* 7. "Liên Hệ" header button — subtle violet border glow */
      .button-transparent:hover {
        box-shadow: 0 0 12px rgba(108, 77, 255, 0.35);
      }

      /* 8. Violet glow on sticky circle (Our Work section) */
      .sticky-circle:hover {
        box-shadow: 0 0 18px rgba(34, 211, 238, 0.35);
      }

      /* Fix for "Chi tiết" buttons text dropping down and clipping accents */
      .btn-title-text {
        white-space: nowrap !important;
        line-height: 1.4 !important;
        padding-top: 3px !important;
        padding-bottom: 3px !important;
      }
      
      .btn-banner-text {
        line-height: 1.4 !important;
      }

      /* 9. h6 subtitle tag — Electric Violet */
      .h6-subtitle {
        color: #6C4DFF !important;
      }

      /* 10. Footer video section */
      .footer-con {
        z-index: 1;
        background-color: #0B1026;
      }

      /* === Z-index stacking for sticky footer reveal pattern === */
      .main-header {
        top: 0 !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
      }
      .menu-dark-container {
        top: 0 !important;
        margin-top: 0 !important;
        border-top-left-radius: 0 !important;
        border-top-right-radius: 0 !important;
      }

      .home-1-section {
        z-index: 90;
        position: relative;
      }
      .video-section {
        position: relative;
        z-index: 40;
      }
      .page-content-wrapper {
        position: relative;
        z-index: 30;
      }
      .section-scroll-video {
        position: relative;
        z-index: 25;
      }
      .sectiohn-scroll-headings,
      .bottom-page-content {
        position: relative;
        z-index: 15;
        overflow: hidden;
      }
      
      @media (max-width: 479px) {
        /* Force long titles to wrap and prevent container expansion */
        .text-animation, h1, h2, h3, h4, h5, h6 {
          white-space: normal !important;
          word-wrap: break-word !important;
          max-width: 100% !important;
        }
        /* Reset any excessive margins/widths on containers to prevent grid blowout */
        .grid-wrapper, .four-column, .flex-container, .advantages-wrap, .about-us-left-con {
          max-width: 100% !important;
          width: 100% !important;
          min-width: 0 !important; /* Fix grid blowout */
          box-sizing: border-box !important;
        }
        .grid-wrapper {
          padding-left: 15px !important;
          padding-right: 15px !important;
          display: block !important; /* Force block to kill 3-column grid on mobile */
        }
        .text-animation-wrapper {
          height: auto !important; /* Prevent text clipping if wrapping */
          overflow: visible !important;
        }
      }
    </style>
  </head>
  <body class="body">
    {showNav && <Header lang={lang} />}
    <slot />
    {showNav && <Footer lang={lang} />}

    <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=648aca18f05d659650f20acc" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous" is:inline></script>
    <script src="https://cdn.prod.website-files.com/648aca18f05d659650f20acc/js/webflow.be4f89e7210dfaadfd3a743cde284196.js" type="text/javascript" is:inline></script>
  </body>
</html>
