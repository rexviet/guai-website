---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { getCaseStudies } from '../../lib/strapi-client';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies('vi');
  return caseStudies.map((work: any) => ({
    params: { slug: work?.slug || 'kakao-wcopilot-ai-campaign' },
    props: { work },
  }));
}

const { work } = Astro.props;
const title = work?.title || 'Chi tiết dự án';
const seo = {
  title: `${title} | GUAI Studio`,
  description: work?.description || 'Chi tiết dự án sáng tạo AI.',
};
---

<BaseLayout seo={seo} lang="vi">
  <main class="page-work-detail" style="padding-top: 120px;">
    <Section>
      <div style="max-width: 900px; margin: 0 auto;">
        <span style="font-weight: 700; color: var(--color-accent); font-size: 0.85rem; text-transform: uppercase;">{work?.category || 'GenAI Commercial'} • {work?.client || 'Client'}</span>
        <h1 style="font-size: 3rem; margin: 1rem 0; line-height: 1.2;">{title}</h1>
        <p style="color: var(--color-text-muted); font-size: 1.2rem; line-height: 1.6; margin-bottom: 2rem;">{work?.description}</p>
        
        {work?.metrics && (
          <div style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--color-accent); color: var(--color-bg); font-weight: bold; border-radius: 50px; margin-bottom: 2rem;">
            📊 Kết quả: {work.metrics}
          </div>
        )}

        {work?.image && (
          <div style="margin-top: var(--space-lg); border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-white-10);">
            <img src={work.image} alt={title} style="width: 100%; aspect-ratio: 16/9; object-fit: cover;" />
          </div>
        )}

        <div style="display: flex; gap: 1rem; align-items: center;">
          <Button href="/" variant="secondary">← Quay lại trang chủ</Button>
          <Button href="/contact" variant="primary">Tư vấn dự án tương tự</Button>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
