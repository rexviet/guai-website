---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import ContactForm from '../../components/forms/ContactForm.astro';

const seo = {
  title: 'Contact Us & Submit Brief | GUAI Studio',
  description: 'Submit your project brief for GenAI video ads, Virtual KOL, and AI visual effects to GUAI Studio. Get response within 24 hours.',
};

const siteUrl = import.meta.env?.SITE_URL || 'https://guai.studio';
const canonical = `${siteUrl}/en/contact`;
const alternateVi = `${siteUrl}/contact`;
---

<BaseLayout seo={seo} lang="en">
  <head slot="head">
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="vi" href={alternateVi} />
    <link rel="alternate" hreflang="x-default" href={alternateVi} />
  </head>

  <main class="page-contact">
    <Section>
      <div class="contact-hero">
        <span class="badge">Get In Touch</span>
        <h1 class="hero-title">Connect & Innovate Together</h1>
        <p class="hero-subtitle">
          Contact GuAI Studio to elevate your brand story into futuristic cinematic visual media powered by state-of-the-art Generative AI.
        </p>
      </div>

      <div class="contact-container">
        <!-- Left: Form -->
        <div class="form-wrapper">
          <ContactForm locale="en" />
        </div>

        <!-- Right: Info & FAQ -->
        <div class="info-sidebar">
          <!-- Info Card -->
          <Card class="sidebar-card info-card">
            <h3 class="card-title">Direct Contact Channels</h3>
            
            <div class="info-list">
              <div class="info-item">
                <div class="info-icon">✉</div>
                <div>
                  <span class="info-label">Email Brief & Inquiries</span>
                  <a href="mailto:contact@guai.studio" class="info-value">contact@guai.studio</a>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">📞</div>
                <div>
                  <span class="info-label">Hotline & WhatsApp / Zalo</span>
                  <a href="tel:+84901234567" class="info-value">+84 (0) 901 234 567</a>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">📍</div>
                <div>
                  <span class="info-label">Studio Creative Hub</span>
                  <p class="info-value">District 1, Ho Chi Minh City, Vietnam</p>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">⏰</div>
                <div>
                  <span class="info-label">Business Hours</span>
                  <p class="info-value">Monday - Friday: 09:00 - 18:00 (GMT+7)</p>
                </div>
              </div>
            </div>
          </Card>

          <!-- FAQ Card -->
          <Card class="sidebar-card faq-card">
            <h3 class="card-title">Frequently Asked Questions</h3>
            
            <div class="faq-list">
              <div class="faq-item">
                <h4 class="faq-q">1. How fast do you respond to briefs?</h4>
                <p class="faq-a">Our creative strategy team will analyze your brief and return a preliminary proposal within 24 business hours.</p>
              </div>

              <div class="faq-item">
                <h4 class="faq-q">2. Do you help with creative direction and scripts?</h4>
                <p class="faq-a">Yes! We provide end-to-end services from Concepting, Storyboarding, and Scriptwriting to AI Rendering and Audio Design.</p>
              </div>

              <div class="faq-item">
                <h4 class="faq-q">3. What is the turnaround time for AI Video production?</h4>
                <p class="faq-a">With our proprietary GenAI pipeline, production speed is accelerated by 50% to 70% compared to traditional filming & CGI setups.</p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .page-contact {
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .contact-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .badge {
    display: inline-block;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    background: rgba(56, 152, 236, 0.1);
    border: 1px solid rgba(56, 152, 236, 0.3);
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #ffffff 30%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .contact-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    background: rgba(17, 17, 17, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    backdrop-filter: blur(12px);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .info-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: rgba(56, 152, 236, 0.12);
    border: 1px solid rgba(56, 152, 236, 0.3);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .info-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .info-value {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a.info-value:hover {
    color: var(--color-accent);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .faq-q {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .faq-a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
