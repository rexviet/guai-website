---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Marquee from '../../components/advanced/Marquee.astro';
import { getServices, getCaseStudies } from '../../lib/strapi-client';

const locale = 'en';
const services = await getServices(locale);
const caseStudies = await getCaseStudies(locale);

const seo = {
  title: 'GUAI Studio | Next-Gen AI Technology Studio',
  description: 'Pioneering AI Commercial Video Ads, Virtual KOLs, and Motion VFX in APAC.',
};

const techStack = [
  "GOOGLE VEO 3.1", "MIDJOURNEY V6", "RUNWAY GEN-3", "FLUX.1", 
  "STABLE DIFFUSION", "ELEVENLABS", "UNREAL ENGINE 5", "BLENDER 3D"
];
---

<style>
  .hero-section {
    position: relative;
    padding-top: 140px;
    padding-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(56, 152, 236, 0.25) 0%, rgba(168, 85, 247, 0.15) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-white-5);
    border: 1px solid var(--color-white-15, rgba(255, 255, 255, 0.15));
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    backdrop-filter: blur(12px);
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 900px;
    margin-bottom: var(--space-md);
    z-index: 1;
  }

  .hero-title .gradient-text {
    background: linear-gradient(135deg, #ffffff 30%, #3898ec 70%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 680px;
    margin-bottom: var(--space-lg);
    line-height: 1.6;
    z-index: 1;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    z-index: 1;
    margin-bottom: var(--space-xl);
  }

  .showreel-container {
    position: relative;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 16/9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-white-15, rgba(255, 255, 255, 0.15));
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8);
    background: var(--color-surface);
    z-index: 1;
  }

  .showreel-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7);
  }

  .showreel-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, transparent 40%, rgba(0,0,0,0.8) 100%);
  }

  .play-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .play-btn:hover {
    transform: scale(1.1);
    background: var(--color-accent);
    box-shadow: 0 0 30px var(--color-accent);
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-xl);
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin-bottom: var(--space-xs);
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .service-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .tag-pill {
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-white-5);
    border: 1px solid var(--color-white-10);
    color: var(--color-text-muted);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-lg);
  }

  .work-thumb {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
  }

  .work-metrics {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #3898ec;
    margin-bottom: 0.5rem;
  }

  .marquee-item {
    padding: 0 2rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    opacity: 0.6;
  }
</style>

<BaseLayout seo={seo} lang={locale}>
  <main class="page-home">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-glow"></div>
      
      <div class="badge-tag">
        <span>✨ Next-Gen AI Creative Studio</span>
      </div>

      <h1 class="hero-title">
        Transforming Visions Into <span class="gradient-text">Cinematic AI Realities</span>
      </h1>

      <p class="hero-subtitle">
        GUAI Studio produces high-end GenAI commercial ads, 3D Virtual KOLs, and futuristic visual effects for global brands.
      </p>

      <div class="hero-cta">
        <Button href="/en/services" variant="primary">Explore Services</Button>
        <Button href="/en/work/kakao-wcopilot-ai-campaign" variant="secondary">Watch 2026 Showreel</Button>
      </div>

      <!-- Showreel Video Preview -->
      <div class="showreel-container">
        <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop" alt="GUAI Studio Showreel" class="showreel-bg" />
        <div class="showreel-overlay">
          <div class="play-btn">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Marquee -->
    <div style="padding: var(--space-md) 0; border-y: 1px solid var(--color-white-10); background: var(--color-surface);">
      <Marquee speed="25s">
        {techStack.map(item => (
          <span class="marquee-item">• {item}</span>
        ))}
      </Marquee>
    </div>

    <!-- Featured Services Section -->
    <Section id="services">
      <div class="section-header">
        <h2 class="section-title">Breakthrough AI Services</h2>
        <p class="section-desc">End-to-end solutions from GenAI video production to 3D Virtual Human creation.</p>
      </div>

      <div class="services-grid">
        {services.map((service: any) => (
          <Card>
            <div class="service-card-inner">
              <h3 style="font-size: 1.3rem; margin-bottom: 0.75rem;">{service.attributes?.title}</h3>
              <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.5;">{service.attributes?.description}</p>
              
              {service.attributes?.tags && (
                <div class="service-tags">
                  {service.attributes.tags.map((tag: string) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>
    </Section>

    <!-- Featured Works Section -->
    <Section id="works">
      <div class="section-header">
        <h2 class="section-title">Selected Works</h2>
        <p class="section-desc">Explore our flagship AI commercial campaigns and creative productions.</p>
      </div>

      <div class="works-grid">
        {caseStudies.map((work: any) => (
          <Card>
            {work.attributes?.image && (
              <img src={work.attributes.image} alt={work.attributes.title} class="work-thumb" />
            )}
            {work.attributes?.metrics && (
              <span class="work-metrics">{work.attributes.metrics}</span>
            )}
            <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{work.attributes?.title}</h3>
            <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1rem;">{work.attributes?.description}</p>
            <Button href={`/en/work/${work.attributes?.slug}`} variant="ghost">View Case Study →</Button>
          </Card>
        ))}
      </div>
    </Section>
  </main>
</BaseLayout>
