---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices, getCaseStudies, getSiteSettings } from '../lib/strapi-client';

const locale = 'vi';
const siteSettings = await getSiteSettings(locale);
const services = await getServices(locale);
const caseStudies = await getCaseStudies(locale);
---

<BaseLayout
  lang={locale}
  seo={{
    metaTitle: "GuAI Studio - Sáng tạo nội dung với AI",
    metaDescription: "GuAI Studio cung cấp các giải pháp sáng tạo nội dung mạnh mẽ dựa trên công nghệ AI."
  }}
>
<div
      data-w-id="bd1cbc60-077b-0eeb-98c4-c170d090ec19"
      class="home-1-section"
    >
      <div class="parallax-video-banner">
        <figure
          data-poster-url={siteSettings.banner_video?.poster_url || ''}
          data-video-urls={`${siteSettings.banner_video?.mp4_url || ''},${siteSettings.banner_video?.webm_url || ''}`}
          data-autoplay="true"
          data-loop="true"
          data-wf-ignore="true"
          id="BG-video"
          class="home-1-video w-node-bd1cbc60-077b-0eeb-98c4-c170d090ec1d-50f20c2b w-background-video w-background-video-atom"
        >
          <video
            id="bd1cbc60-077b-0eeb-98c4-c170d090ec1d-video"
            autoplay=""
            loop=""
            style={`background-image: url("${siteSettings.banner_video?.poster_url || ''}");`}
            muted=""
            playsinline=""
            data-wf-ignore="true"
            data-object-fit="cover"
          >
            {siteSettings.banner_video?.mp4_url && (
              <source src={siteSettings.banner_video.mp4_url} data-wf-ignore="true" />
            )}
            {siteSettings.banner_video?.webm_url && (
              <source src={siteSettings.banner_video.webm_url} data-wf-ignore="true" />
            )}
          </video>
          <div class="banner-video-ov"></div>
        </figure>
      </div>
      <div
        id="w-node-bd1cbc60-077b-0eeb-98c4-c170d090ec1f-50f20c2b"
        class="video-ov-banner"
      >
        <div class="base-container">
          <div class="home-hero-content">
            <div class="home-1-hero-title">
              <h1
                data-w-id="44e490e8-94df-d6fc-c177-03801ee8f206"
                style="opacity: 0"
                class="title-home-1"
              >
                ĐỊNH HÌNH TƯƠNG LAI<br />
                SÁNG TẠO BẰNG AI
              </h1>
              <p
                data-w-id="30ca54f6-73ed-1f90-e7e1-36feec46e296"
                style="opacity: 0"
                class="banner-long-description"
              >
                GuAI Studio định vị là AI Creative & Growth Agency, ứng dụng AI xuyên suốt từ sáng tạo nội dung, xây dựng hình ảnh thương hiệu, phát triển kênh social đến hỗ trợ bán hàng. Partner có thể sử dụng tài liệu này để giới thiệu nhanh phạm vi dịch vụ và định hướng ngân sách cho khách hàng.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <style is:inline>
      /* Turn the services grid into a horizontal slider */
      .advantages-list {
        display: flex !important;
        flex-wrap: nowrap !important;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 15px;
        padding-bottom: 20px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.3) transparent;
      }
      
      .advantages-list::-webkit-scrollbar {
        height: 6px;
      }
      
      .advantages-list::-webkit-scrollbar-track {
        background: transparent;
      }
      
      .advantages-list::-webkit-scrollbar-thumb {
        background-color: rgba(255,255,255,0.3);
        border-radius: 10px;
      }
      
      .advantages-list > .mini-video-lightbox {
        flex: 0 0 calc(33.3333% - 10px) !important; /* Show 3 items */
        scroll-snap-align: start;
        min-width: 280px;
      }
      
      @media (max-width: 991px) {
        .advantages-list > .mini-video-lightbox {
          flex: 0 0 calc(50% - 7.5px) !important; /* Show 2 items on tablet */
        }
      }
      
      @media (max-width: 479px) {
        .advantages-list > .mini-video-lightbox {
          flex: 0 0 100% !important; /* Show 1 item on mobile */
        }
        
        .slider-nav-btn {
          display: none !important;
        }
        
        .advantages-wrap {
          width: 100% !important;
          box-sizing: border-box !important;
          padding-left: 15px !important;
          padding-right: 15px !important;
        }
      }
    </style>

