---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import ContactForm from '../components/forms/ContactForm.astro';

const seo = {
  title: 'Liên Hệ Brief Dự Án | GUAI Studio',
  description: 'Gửi brief dự án sản xuất video GenAI, Virtual KOL và kỹ thảo visual AI cho GUAI Studio. Phản hồi trong 24 giờ.',
};

const siteUrl = import.meta.env?.SITE_URL || 'https://guai.studio';
const canonical = `${siteUrl}/contact`;
const alternateEn = `${siteUrl}/en/contact`;
---

<BaseLayout seo={seo} lang="vi">
  <head slot="head">
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
  </head>

  <main class="page-contact">
    <Section>
      <div class="base-container w-container" style="padding: 0 5%;">
        <div class="contact-hero">
          <span class="badge">Liên Hệ</span>
          <h1 class="hero-title">Kết Nối & Hợp Tác Sáng Tạo</h1>
          <p class="hero-subtitle">
            Gửi cho chúng tôi sản phẩm hoặc campaign brief. Team sẽ đề xuất cách AI có thể được ứng dụng vào chiến dịch.
          </p>
        </div>

        <div class="contact-container">
          <!-- Left: Form -->
          <div class="form-wrapper">
            <ContactForm locale="vi" />
          </div>

          <!-- Right: Info & FAQ -->
          <div class="info-sidebar">
            <!-- Info Card -->
            <Card class="sidebar-card info-card">
              <h3 class="card-title">Thông Tin Liên Hệ</h3>
              
              <div class="info-list">
                <div class="info-item">
                  <div class="info-icon">📍</div>
                  <div>
                    <span class="info-label">AI MEDIA STUDIO</span>
                    <p class="info-value">Ho Chi Minh City, Vietnam</p>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">✉</div>
                  <div>
                    <span class="info-label">Email</span>
                    <a href="mailto:contact@guai.studio" class="info-value track-cta" data-tracking="click_email">contact@guai.studio</a>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">📞</div>
                  <div>
                    <span class="info-label">Phone / Zalo</span>
                    <a href="tel:+84901234567" class="info-value track-cta" data-tracking="click_phone">+84 (0) 901 234 567</a>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">🌐</div>
                  <div>
                    <span class="info-label">Mạng Xã Hội</span>
                    <div class="social-links" style="display: flex; gap: 10px; margin-top: 5px;">
                      <a href="#" class="info-value track-cta" data-tracking="click_facebook">Facebook</a>
                      <a href="#" class="info-value track-cta" data-tracking="click_tiktok">TikTok</a>
                      <a href="#" class="info-value track-cta" data-tracking="click_youtube">YouTube</a>
                      <a href="#" class="info-value track-cta" data-tracking="click_linkedin">LinkedIn</a>
                    </div>
                  </div>
                </div>
              </div>
            </Card>

            <!-- CTA Nhanh Card -->
            <Card class="sidebar-card faq-card">
              <h3 class="card-title">Hỗ Trợ Nhanh</h3>
              <div style="display: flex; flex-direction: column; gap: 10px;">
                <a href="#" class="btn-submit track-cta" data-tracking="click_zalo" style="text-align: center; text-decoration: none; padding: 10px; border-radius: 8px; background: #0068FF; color: white; font-weight: bold;">
                  Chat Zalo
                </a>
                <a href="#" class="btn-submit track-cta" data-tracking="click_messenger" style="text-align: center; text-decoration: none; padding: 10px; border-radius: 8px; background: #0084FF; color: white; font-weight: bold;">
                  Messenger
                </a>
              </div>
            </Card>

            <!-- Partner Notes Card -->
            <Card class="sidebar-card partner-card" style="background: rgba(17, 17, 17, 0.8);">
              <h3 class="card-title" style="color: var(--color-accent); font-size: 1.3rem; border-bottom: none; margin-bottom: 0.5rem; padding-bottom: 0;">Lưu ý dành cho Partner</h3>
              <ul style="color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.6; padding-left: 1.2rem; margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <li>Giá trong tài liệu là mức tham khảo/starting price, không phải báo giá cố định.</li>
                <li>Partner cần xác nhận scope với GuAI Studio trước khi gửi báo giá chính thức cho khách.</li>
                <li>Không tự ý giảm giá hoặc cam kết tính năng/timeline chưa được Production xác nhận.</li>
                <li>Với dự án có yêu cầu tích hợp kỹ thuật, CRM, API hoặc automation, cần khảo sát hệ thống trước khi báo giá.</li>
                <li>Ưu tiên bán giải pháp theo tháng/retainer để khách hàng có kết quả dài hạn và GuAI có thể liên tục tối ưu.</li>
              </ul>
            </Card>
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .page-contact {
    padding-top: 120px;
    padding-bottom: 80px;
    position: relative;
    z-index: 50;
    background-color: #0e0e0e;
    min-height: 100vh;
  }

  .contact-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .badge {
    display: inline-block;
    font-weight: 700;
    color: #22D3EE;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    background: rgba(108, 77, 255, 0.12);
    border: 1px solid rgba(108, 77, 255, 0.4);
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #ffffff 20%, #6C4DFF 60%, #22D3EE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .contact-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    background: rgba(13, 21, 48, 0.8);
    border: 1px solid rgba(108, 77, 255, 0.2);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    backdrop-filter: blur(12px);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .info-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: rgba(56, 152, 236, 0.12);
    border: 1px solid rgba(56, 152, 236, 0.3);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .info-label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .info-value {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a.info-value:hover {
    color: var(--color-accent);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .faq-q {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .faq-a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
