---
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const baseClass = "ui-button";
const variantClass = `ui-button--${variant}`;
const combinedClass = [baseClass, variantClass, className].filter(Boolean).join(" ");
---

<style>
  .ui-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: all var(--transition-fast);
    cursor: pointer;
    border: none;
    font-family: var(--font-primary);
  }

  .ui-button--primary {
    background-color: var(--color-accent);
    color: var(--color-text);
  }

  .ui-button--primary:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(56, 152, 236, 0.4);
  }

  .ui-button--secondary {
    background-color: var(--color-surface-elevated);
    color: var(--color-text);
    border: 1px solid var(--color-white-10);
  }

  .ui-button--secondary:hover {
    background-color: var(--color-white-10);
  }

  .ui-button--ghost {
    background-color: transparent;
    color: var(--color-text);
  }

  .ui-button--ghost:hover {
    background-color: var(--color-white-5);
  }
</style>

{href ? (
  <a href={href} class={combinedClass}>
    <slot />
  </a>
) : (
  <button class={combinedClass}>
    <slot />
  </button>
)}
