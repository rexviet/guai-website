---
export interface Props {
  locale?: 'vi' | 'en';
}

const { locale = 'vi' } = Astro.props;
const isEn = locale === 'en';

const turnstileSiteKey = import.meta.env?.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const strapiUrl = import.meta.env?.STRAPI_URL || 'http://localhost:1337';

const texts = {
  vi: {
    title: 'Gửi Brief Dự Án',
    subtitle: 'Gửi cho chúng tôi sản phẩm hoặc campaign brief. Team sẽ đề xuất cách AI có thể được ứng dụng vào chiến dịch.',
    fullName: 'Họ tên',
    fullNamePlaceholder: 'Nguyễn Văn A',
    email: 'Email / Phone',
    emailPlaceholder: 'name@company.com hoặc 0901234567',
    website: 'Website / Facebook',
    websitePlaceholder: 'https://...',
    company: 'Công ty',
    companyPlaceholder: 'Tên công ty hoặc thương hiệu',
    service: 'Nhu cầu',
    message: 'Mô tả dự án',
    messagePlaceholder: 'Mô tả ngắn gọn về thương hiệu, mục tiêu chiến dịch, ngân sách dự kiến...',
    attachment: 'Upload Product/Brief (PDF, DOCX, PNG, MP4, tối đa 10MB)',
    submit: 'GỬI BRIEF',
    submitting: 'Đang gửi thông tin...',
    successTitle: 'Gửi brief thành công!',
    successDesc: 'Cảm ơn bạn đã liên hệ với GuAI Studio. Chúng tôi sẽ nghiên cứu brief và phản hồi sớm nhất.',
    errorTitle: 'Không thể gửi brief',
    requiredField: 'Vui lòng điền thông tin này',
    invalidEmail: 'Email không hợp lệ',
  },
  en: {
    title: 'Submit Your Project Brief',
    subtitle: 'Send us your product or campaign brief. Our team will propose how AI can be applied to your campaign.',
    fullName: 'Full Name',
    fullNamePlaceholder: 'Alex Morgan',
    email: 'Email / Phone',
    emailPlaceholder: 'alex@company.com or +84901234567',
    website: 'Website / Facebook',
    websitePlaceholder: 'https://...',
    company: 'Company',
    companyPlaceholder: 'Your company name',
    service: 'Requirements',
    message: 'Project Description',
    messagePlaceholder: 'Brief description of your brand, campaign goals, target timeline, estimated budget...',
    attachment: 'Upload Product/Brief (PDF, DOCX, PNG, MP4, max 10MB)',
    submit: 'SEND BRIEF',
    submitting: 'Submitting brief...',
    successTitle: 'Brief Submitted Successfully!',
    successDesc: 'Thank you for reaching out to GuAI Studio. Our creative team will review your brief and get back to you shortly.',
    errorTitle: 'Submission Failed',
    requiredField: 'This field is required',
    invalidEmail: 'Invalid email address',
  }
};

const t = isEn ? texts.en : texts.vi;

const serviceOptions = [
  { value: 'ai-video', label: isEn ? 'AI Video' : 'AI Video' },
  { value: 'ai-kol', label: isEn ? 'AI KOL' : 'AI KOL' },
  { value: 'ai-ads', label: isEn ? 'AI Ads' : 'AI Ads' },
  { value: 'social-content', label: isEn ? 'Social Content' : 'Social Content' },
  { value: 'channel-building', label: isEn ? 'Xây Channel' : 'Xây Channel' },
  { value: 'other', label: isEn ? 'Other' : 'Khác' },
];
---

<!-- Turnstile Script -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<div class="contact-form-card" data-strapi-url={strapiUrl}>

  <div id="form-alert-success" class="alert alert-success hidden" role="alert">
    <div class="alert-icon">✓</div>
    <div>
      <h4 class="alert-heading">{t.successTitle}</h4>
      <p class="alert-message">{t.successDesc}</p>
    </div>
  </div>

  <div id="form-alert-error" class="alert alert-error hidden" role="alert">
    <div class="alert-icon">!</div>
    <div>
      <h4 class="alert-heading">{t.errorTitle}</h4>
      <p id="form-error-message" class="alert-message"></p>
    </div>
  </div>

  <form id="lead-contact-form" class="lead-form" novalidate>
    <div class="form-grid">
      <!-- Name -->
      <div class="form-group">
        <label for="lead-name" class="form-label">{t.fullName} <span class="required">*</span></label>
        <input
          type="text"
          id="lead-name"
          name="name"
          class="form-input"
          placeholder={t.fullNamePlaceholder}
          required
        />
        <span class="field-error" id="err-name"></span>
      </div>

      <!-- Company -->
      <div class="form-group">
        <label for="lead-company" class="form-label">{t.company}</label>
        <input
          type="text"
          id="lead-company"
          name="company"
          class="form-input"
          placeholder={t.companyPlaceholder}
        />
      </div>

      <!-- Email / Phone -->
      <div class="form-group">
        <label for="lead-email" class="form-label">{t.email} <span class="required">*</span></label>
        <input
          type="text"
          id="lead-email"
          name="email"
          class="form-input"
          placeholder={t.emailPlaceholder}
          required
        />
        <span class="field-error" id="err-email"></span>
      </div>

      <!-- Website / Facebook -->
      <div class="form-group">
        <label for="lead-website" class="form-label">{t.website}</label>
        <input
          type="text"
          id="lead-website"
          name="phone"
          class="form-input"
          placeholder={t.websitePlaceholder}
        />
      </div>
    </div>

    <!-- Service Interest (Checkboxes) -->
    <div class="form-group">
      <label class="form-label">{t.service}</label>
      <div class="checkbox-grid">
        {serviceOptions.map((opt, i) => (
          <label class="checkbox-label" for={`service-${i}`}>
            <input type="checkbox" id={`service-${i}`} name="service_interest[]" value={opt.value} class="form-checkbox" />
            <span class="checkbox-text">{opt.label}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Message -->
    <div class="form-group">
      <label for="lead-message" class="form-label">{t.message} <span class="required">*</span></label>
      <textarea
        id="lead-message"
        name="message"
        rows="4"
        class="form-textarea"
        placeholder={t.messagePlaceholder}
        required
      ></textarea>
      <span class="field-error" id="err-message"></span>
    </div>

    <!-- Attachment -->
    <div class="form-group">
      <label for="lead-attachment" class="form-label">{t.attachment}</label>
      <div class="file-input-wrapper">
        <input
          type="file"
          id="lead-attachment"
          name="attachment"
          class="form-file-input"
          accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.mp4"
        />
      </div>
    </div>

    <!-- Cloudflare Turnstile -->
    <div class="form-group turnstile-wrapper">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="dark"
      ></div>
    </div>

    <!-- Submit Button -->
    <button type="submit" id="btn-submit-lead" class="btn-submit track-cta" data-tracking="submit_brief">
      <span class="btn-text">{t.submit}</span>
      <span class="btn-spinner hidden"></span>
    </button>
  </form>
</div>

<style>
  .contact-form-card {
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.9);
  }

  .required {
    color: var(--color-accent);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 1.25rem;
    background: rgba(11, 16, 38, 0.6);
    border: 1px solid rgba(108, 77, 255, 0.2);
    border-radius: 8px;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #6C4DFF;
    background: rgba(108, 77, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(108, 77, 255, 0.15);
  }

  .form-select option {
    background: #111111;
    color: #ffffff;
  }

  .checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .form-checkbox {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .form-file-input {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 0;
    width: 100%;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .form-file-input::file-selector-button {
    background: rgba(108, 77, 255, 0.15);
    border: 1px solid #6C4DFF;
    color: var(--color-text);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    margin-right: 0.75rem;
    transition: background var(--transition-fast);
  }

  .form-file-input::file-selector-button:hover {
    background: #6C4DFF;
  }

  .field-error {
    color: var(--color-danger);
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }

  .turnstile-wrapper {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-start;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1.25rem 2rem;
    background: linear-gradient(135deg, #6C4DFF 0%, #22D3EE 100%);
    color: #ffffff;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.35s ease;
    margin-top: 1rem;
    box-shadow: 0 0 20px rgba(108, 77, 255, 0.35);
  }

  .btn-submit:hover:not(:disabled) {
    background: linear-gradient(135deg, #8a6bff 0%, #38e8ff 100%);
    box-shadow: 0 0 35px rgba(108, 77, 255, 0.65), 0 0 60px rgba(34, 211, 238, 0.2);
    transform: translateY(-2px);
  }

  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-spinner {
    width: 1.2rem;
    height: 1.2rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 0.5rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .alert {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }

  .alert-success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .alert-icon {
    font-weight: bold;
    font-size: 1.1rem;
  }

  .alert-heading {
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .alert-message {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  import { validateLeadForm, submitLead } from '../../lib/lead-client';

  const formCard = document.querySelector('.contact-form-card') as HTMLElement;
  const form = document.getElementById('lead-contact-form') as HTMLFormElement;
  const btnSubmit = document.getElementById('btn-submit-lead') as HTMLButtonElement;
  const btnText = btnSubmit?.querySelector('.btn-text');
  const btnSpinner = btnSubmit?.querySelector('.btn-spinner');
  const alertSuccess = document.getElementById('form-alert-success');
  const alertError = document.getElementById('form-alert-error');
  const errorMessageEl = document.getElementById('form-error-message');

  const strapiUrl = formCard?.dataset?.strapiUrl || 'http://localhost:1337';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous alerts
      alertSuccess?.classList.add('hidden');
      alertError?.classList.add('hidden');
      document.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));

      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const email = (formData.get('email') as string) || '';
      const message = (formData.get('message') as string) || '';

      const validation = validateLeadForm({ name, email, message });

      if (!validation.isValid) {
        if (validation.errors.name) {
          const errName = document.getElementById('err-name');
          if (errName) errName.textContent = validation.errors.name;
        }
        if (validation.errors.email) {
          const errEmail = document.getElementById('err-email');
          if (errEmail) errEmail.textContent = validation.errors.email;
        }
        if (validation.errors.message) {
          const errMsg = document.getElementById('err-message');
          if (errMsg) errMsg.textContent = validation.errors.message;
        }
        return;
      }

      // Check Turnstile token if widget exists
      const turnstileInput = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      if (turnstileInput && turnstileInput.value) {
        formData.append('turnstileToken', turnstileInput.value);
      }

      // Set Loading state
      btnSubmit.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');

      try {
        const result = await submitLead(formData, strapiUrl);

        if (result.success) {
          alertSuccess?.classList.remove('hidden');
          form.reset();
          if ((window as any).turnstile) {
            (window as any).turnstile.reset();
          }
        } else {
          if (errorMessageEl) errorMessageEl.textContent = result.message;
          alertError?.classList.remove('hidden');
        }
      } catch (err: any) {
        if (errorMessageEl) errorMessageEl.textContent = err.message || 'Lỗi không xác định.';
        alertError?.classList.remove('hidden');
      } finally {
        btnSubmit.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    });
  }
</script>
