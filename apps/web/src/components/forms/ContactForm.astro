---
export interface Props {
  locale?: 'vi' | 'en';
}

const { locale = 'vi' } = Astro.props;
const isEn = locale === 'en';

const turnstileSiteKey = import.meta.env?.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const strapiUrl = import.meta.env?.STRAPI_URL || 'http://localhost:1337';

const texts = {
  vi: {
    title: 'Gửi Brief Dự Án',
    subtitle: 'Hãy chia sẻ nhu cầu sản xuất của bạn. Đội ngũ chuyên gia GuAI Studio sẽ tư vấn và phản hồi trong 24 giờ làm việc.',
    fullName: 'Họ và tên',
    fullNamePlaceholder: 'Nguyễn Văn A',
    email: 'Địa chỉ Email',
    emailPlaceholder: 'name@company.com',
    phone: 'Số điện thoại / Zalo',
    phonePlaceholder: '090 123 4567',
    company: 'Doanh nghiệp / Thương hiệu',
    companyPlaceholder: 'Tên công ty hoặc thương hiệu',
    service: 'Dịch vụ quan tâm',
    selectService: '-- Chọn dịch vụ --',
    message: 'Nội dung Brief / Yêu cầu',
    messagePlaceholder: 'Mô tả ngắn gọn về thương hiệu, mục tiêu chiến dịch, ngân sách dự kiến...',
    attachment: 'Đính kèm file brief / Ý tưởng (PDF, DOCX, PNG, MP4, tối đa 10MB)',
    submit: 'Gửi Yêu Cầu Tư Vấn',
    submitting: 'Đang gửi thông tin...',
    successTitle: 'Gửi brief thành công!',
    successDesc: 'Cảm ơn bạn đã liên hệ với GuAI Studio. Chúng tôi sẽ nghiên cứu brief và phản hồi sớm nhất.',
    errorTitle: 'Không thể gửi brief',
    requiredField: 'Vui lòng điền thông tin này',
    invalidEmail: 'Email không hợp lệ',
  },
  en: {
    title: 'Submit Your Project Brief',
    subtitle: 'Share your campaign requirements with us. GuAI Studio specialists will analyze your brief and respond within 24 business hours.',
    fullName: 'Full Name',
    fullNamePlaceholder: 'Alex Morgan',
    email: 'Email Address',
    emailPlaceholder: 'alex@company.com',
    phone: 'Phone Number',
    phonePlaceholder: '+84 90 123 4567',
    company: 'Company / Brand Name',
    companyPlaceholder: 'Your company name',
    service: 'Service Interest',
    selectService: '-- Select Service --',
    message: 'Project Brief / Requirements',
    messagePlaceholder: 'Brief description of your brand, campaign goals, target timeline, estimated budget...',
    attachment: 'Attach Brief File (PDF, DOCX, PNG, MP4, max 10MB)',
    submit: 'Send Request',
    submitting: 'Submitting brief...',
    successTitle: 'Brief Submitted Successfully!',
    successDesc: 'Thank you for reaching out to GuAI Studio. Our creative team will review your brief and get back to you shortly.',
    errorTitle: 'Submission Failed',
    requiredField: 'This field is required',
    invalidEmail: 'Invalid email address',
  }
};

const t = isEn ? texts.en : texts.vi;

const serviceOptions = [
  { value: 'genai-commercial-video', label: isEn ? 'GenAI Commercial Video Ads (TVC / Viral)' : 'Sản Xuất Video Quảng Cáo AI (GenAI Video Ads)' },
  { value: 'virtual-kol-creation', label: isEn ? 'Virtual KOL & 3D Digital Human' : 'Thiết Kế & Vận Hành Virtual KOL / AI Avatar' },
  { value: 'ai-vfx-motion', label: isEn ? 'AI VFX & Motion Graphics' : 'Kỹ Thảo Kỹ Thuật Số & Motion Graphics AI' },
  { value: 'ai-brand-storytelling', label: isEn ? 'AI Brand Storytelling & Creative Direction' : 'Chiến Lược Thương Hiệu & Kịch Bản AI' },
  { value: 'other', label: isEn ? 'Other Custom AI Solution' : 'Giải Pháp AI Khác' },
];
---

<!-- Turnstile Script -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<div class="contact-form-card" data-strapi-url={strapiUrl}>
  <div class="form-header">
    <h2 class="form-title">{t.title}</h2>
    <p class="form-subtitle">{t.subtitle}</p>
  </div>

  <div id="form-alert-success" class="alert alert-success hidden" role="alert">
    <div class="alert-icon">✓</div>
    <div>
      <h4 class="alert-heading">{t.successTitle}</h4>
      <p class="alert-message">{t.successDesc}</p>
    </div>
  </div>

  <div id="form-alert-error" class="alert alert-error hidden" role="alert">
    <div class="alert-icon">!</div>
    <div>
      <h4 class="alert-heading">{t.errorTitle}</h4>
      <p id="form-error-message" class="alert-message"></p>
    </div>
  </div>

  <form id="lead-contact-form" class="lead-form" novalidate>
    <div class="form-grid">
      <!-- Name -->
      <div class="form-group">
        <label for="lead-name" class="form-label">{t.fullName} <span class="required">*</span></label>
        <input
          type="text"
          id="lead-name"
          name="name"
          class="form-input"
          placeholder={t.fullNamePlaceholder}
          required
        />
        <span class="field-error" id="err-name"></span>
      </div>

      <!-- Email -->
      <div class="form-group">
        <label for="lead-email" class="form-label">{t.email} <span class="required">*</span></label>
        <input
          type="email"
          id="lead-email"
          name="email"
          class="form-input"
          placeholder={t.emailPlaceholder}
          required
        />
        <span class="field-error" id="err-email"></span>
      </div>

      <!-- Phone -->
      <div class="form-group">
        <label for="lead-phone" class="form-label">{t.phone}</label>
        <input
          type="tel"
          id="lead-phone"
          name="phone"
          class="form-input"
          placeholder={t.phonePlaceholder}
        />
      </div>

      <!-- Company -->
      <div class="form-group">
        <label for="lead-company" class="form-label">{t.company}</label>
        <input
          type="text"
          id="lead-company"
          name="company"
          class="form-input"
          placeholder={t.companyPlaceholder}
        />
      </div>
    </div>

    <!-- Service Interest -->
    <div class="form-group">
      <label for="lead-service" class="form-label">{t.service}</label>
      <select id="lead-service" name="service_interest" class="form-select">
        <option value="">{t.selectService}</option>
        {serviceOptions.map((opt) => (
          <option value={opt.value}>{opt.label}</option>
        ))}
      </select>
    </div>

    <!-- Message -->
    <div class="form-group">
      <label for="lead-message" class="form-label">{t.message} <span class="required">*</span></label>
      <textarea
        id="lead-message"
        name="message"
        rows="4"
        class="form-textarea"
        placeholder={t.messagePlaceholder}
        required
      ></textarea>
      <span class="field-error" id="err-message"></span>
    </div>

    <!-- Attachment -->
    <div class="form-group">
      <label for="lead-attachment" class="form-label">{t.attachment}</label>
      <div class="file-input-wrapper">
        <input
          type="file"
          id="lead-attachment"
          name="attachment"
          class="form-file-input"
          accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.mp4"
        />
      </div>
    </div>

    <!-- Cloudflare Turnstile -->
    <div class="form-group turnstile-wrapper">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="dark"
      ></div>
    </div>

    <!-- Submit Button -->
    <button type="submit" id="btn-submit-lead" class="btn-submit">
      <span class="btn-text">{t.submit}</span>
      <span class="btn-spinner hidden"></span>
    </button>
  </form>
</div>

<style>
  .contact-form-card {
    background: rgba(17, 17, 17, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  }

  @media (min-width: 768px) {
    .contact-form-card {
      padding: var(--space-lg);
    }
  }

  .form-header {
    margin-bottom: var(--space-md);
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .form-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .required {
    color: var(--color-accent);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 0.95rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(56, 152, 236, 0.2);
    background: rgba(255, 255, 255, 0.07);
  }

  .form-select option {
    background: #111111;
    color: #ffffff;
  }

  .form-file-input {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    width: 100%;
    cursor: pointer;
  }

  .form-file-input::file-selector-button {
    background: rgba(56, 152, 236, 0.15);
    border: 1px solid var(--color-accent);
    color: var(--color-text);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    margin-right: 0.75rem;
    transition: background var(--transition-fast);
  }

  .form-file-input::file-selector-button:hover {
    background: var(--color-accent);
  }

  .field-error {
    color: var(--color-danger);
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }

  .turnstile-wrapper {
    margin-top: 0.5rem;
    display: flex;
    justify-content: flex-start;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.9rem 1.5rem;
    background: linear-gradient(135deg, var(--color-accent) 0%, #0066cc 100%);
    color: #ffffff;
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
    box-shadow: 0 4px 16px rgba(56, 152, 236, 0.3);
  }

  .btn-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(56, 152, 236, 0.5);
  }

  .btn-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .btn-spinner {
    width: 1.2rem;
    height: 1.2rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 0.5rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .alert {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }

  .alert-success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .alert-icon {
    font-weight: bold;
    font-size: 1.1rem;
  }

  .alert-heading {
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .alert-message {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  import { validateLeadForm, submitLead } from '../../lib/lead-client';

  const formCard = document.querySelector('.contact-form-card') as HTMLElement;
  const form = document.getElementById('lead-contact-form') as HTMLFormElement;
  const btnSubmit = document.getElementById('btn-submit-lead') as HTMLButtonElement;
  const btnText = btnSubmit?.querySelector('.btn-text');
  const btnSpinner = btnSubmit?.querySelector('.btn-spinner');
  const alertSuccess = document.getElementById('form-alert-success');
  const alertError = document.getElementById('form-alert-error');
  const errorMessageEl = document.getElementById('form-error-message');

  const strapiUrl = formCard?.dataset?.strapiUrl || 'http://localhost:1337';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous alerts
      alertSuccess?.classList.add('hidden');
      alertError?.classList.add('hidden');
      document.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));

      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const email = (formData.get('email') as string) || '';
      const message = (formData.get('message') as string) || '';

      const validation = validateLeadForm({ name, email, message });

      if (!validation.isValid) {
        if (validation.errors.name) {
          const errName = document.getElementById('err-name');
          if (errName) errName.textContent = validation.errors.name;
        }
        if (validation.errors.email) {
          const errEmail = document.getElementById('err-email');
          if (errEmail) errEmail.textContent = validation.errors.email;
        }
        if (validation.errors.message) {
          const errMsg = document.getElementById('err-message');
          if (errMsg) errMsg.textContent = validation.errors.message;
        }
        return;
      }

      // Check Turnstile token if widget exists
      const turnstileInput = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      if (turnstileInput && turnstileInput.value) {
        formData.append('turnstileToken', turnstileInput.value);
      }

      // Set Loading state
      btnSubmit.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');

      try {
        const result = await submitLead(formData, strapiUrl);

        if (result.success) {
          alertSuccess?.classList.remove('hidden');
          form.reset();
          if ((window as any).turnstile) {
            (window as any).turnstile.reset();
          }
        } else {
          if (errorMessageEl) errorMessageEl.textContent = result.message;
          alertError?.classList.remove('hidden');
        }
      } catch (err: any) {
        if (errorMessageEl) errorMessageEl.textContent = err.message || 'Lỗi không xác định.';
        alertError?.classList.remove('hidden');
      } finally {
        btnSubmit.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    });
  }
</script>
