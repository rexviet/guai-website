# -----------------------------------------------------------------------
# infra/.env.example
#
# Copy this file to `infra/.env` and fill in real values before running:
#   docker compose -f infra/docker-compose.yml up -d
#
# NEVER commit the real `infra/.env` file. It is covered by the root
# `.gitignore` (`.env` / `.env.*`); `.env.example` files are explicitly
# excluded from that ignore rule so this template stays tracked in git.
# All values below are placeholders — generate real, unique secrets per
# environment (dev/staging/prod should NOT share values).
# -----------------------------------------------------------------------

# --- PostgreSQL ---
# Consumed directly by the `postgres` service, and reused by the `strapi`
# service (as DATABASE_NAME / DATABASE_USERNAME / DATABASE_PASSWORD) via
# variable interpolation in docker-compose.yml — single source of truth.
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=change_me_strong_password

# --- Strapi <-> PostgreSQL connection ---
# These are fixed for this compose topology and are hardcoded directly in
# docker-compose.yml's `strapi.environment` block (not read from this file):
#   DATABASE_CLIENT=postgres
#   DATABASE_HOST=postgres      (the `postgres` service name; Docker's
#                                internal DNS resolves it on guai-network)
#   DATABASE_PORT=5432
#   DATABASE_NAME=${POSTGRES_DB}
#   DATABASE_USERNAME=${POSTGRES_USER}
#   DATABASE_PASSWORD=${POSTGRES_PASSWORD}
# Listed here only for documentation; no action needed for these.

# --- Strapi secrets ---
# Generate real, unique values per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS takes a comma-separated list (Strapi rotates through them).
APP_KEYS=replace_with_generated_key1,replace_with_generated_key2
API_TOKEN_SALT=replace_with_generated_salt
ADMIN_JWT_SECRET=replace_with_generated_secret
TRANSFER_TOKEN_SALT=replace_with_generated_salt
JWT_SECRET=replace_with_generated_secret
ENCRYPTION_KEY=replace_with_generated_key

# --- Cloudflare R2 media upload provider ---
# Passed through to the `strapi` service by docker-compose.yml. Mirrors
# apps/cms/.env.example, which is what a bare `npm run dev --prefix apps/cms`
# reads instead.
#
# R2_PUBLIC_URL is load-bearing twice over: the upload provider builds asset
# URLs from it, AND config/middlewares.ts allowlists it in the admin panel's
# Content-Security-Policy. If it is missing, the admin shows uploaded media as
# broken ("Media load rejected by URL safety check") even though the files are
# fine on R2.
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET=replace_with_r2_bucket_name
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=replace_with_r2_s3_endpoint
# R2 has no real regions; keep "auto".
R2_REGION=auto
# Public CDN domain bound to the bucket, e.g. https://cdn.guai.studio
R2_PUBLIC_URL=replace_with_r2_public_domain
